APP_NAME=Vinora
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vinora.example.com
APP_TIMEZONE=Europe/Paris

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

# SMTP Hostinger (ou MAIL_MAILER=log tant qu'il n'y a pas d'adresse)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="bonjour@vinora.example.com"
MAIL_FROM_NAME="${APP_NAME}"

INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
